{
  "components": {
    "schemas": {
      "ErrorCategory": {
        "description": "错误的高层分类（对外结论稳定，不随框架/内部实现变化）。",
        "enum": [
          "validation",
          "not_found",
          "method_not_allowed",
          "business",
          "internal"
        ],
        "title": "ErrorCategory",
        "type": "string"
      },
      "ErrorCode": {
        "description": "对外稳定错误码。``value`` 即响应体中的 code 字符串。",
        "enum": [
          "REQUEST_VALIDATION_FAILED",
          "ROUTE_NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "BUSINESS_RULE_VIOLATION",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "单条可定位的错误原因。\n\n- ``location``：字段定位（如 [\"body\", \"age\"]；路由级错误为 [\"path\"]）。\n- ``reason``：机器可读的原因码（如 \"missing\"、\"value_error\"、\"out_of_stock\"）。\n- ``message``：面向调用方的说明，不含内部堆栈/SQL 等敏感细节。",
        "properties": {
          "location": {
            "items": {
              "type": "string"
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "所有失败响应的唯一外壳结构。",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ErrorCategory"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ItemIn": {
        "description": "创建商品的入参（缺字段/类型错误会触发请求校验失败入口）。",
        "properties": {
          "name": {
            "description": "商品名称",
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "description": "库存数量",
            "minimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "quantity"
        ],
        "title": "ItemIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "api-contract-guardrails",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "正常入口。",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Read Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Root"
      }
    },
    "/boom": {
      "get": {
        "description": "未预期异常入口：细节不得对外泄露。",
        "operationId": "boom_boom_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Boom Boom Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "未预期异常（已脱敏）"
          }
        },
        "summary": "Boom"
      }
    },
    "/items": {
      "post": {
        "description": "正常入口；特定商品名触发业务规则拒绝。",
        "operationId": "create_item_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Item Items Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "请求校验失败或业务规则拒绝"
          }
        },
        "summary": "Create Item"
      }
    },
    "/items/{item_id}": {
      "get": {
        "description": "路径参数类型错误（非整数）由框架触发请求校验失败。",
        "operationId": "get_item_items__item_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Item Items  Item Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "请求校验失败或业务规则拒绝"
          }
        },
        "summary": "Get Item"
      }
    }
  }
}